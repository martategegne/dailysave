# DailySave Production Environment Configuration
# Copy this file to .env.production on the production server.
# NEVER commit the filled .env.production file to version control.

# Server Runtime
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Production PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dailysave_prod_db
DB_USER=dailysave_prod_user
DB_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_PASSWORD_64_CHARS
DB_SSL=false
DB_MAX_CONNECTIONS=50
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Security & Cryptographic Secrets
# Generate using: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_OPENSSL_RAND_BASE64_48_CHARS
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# Cross-Origin Resource Sharing (CORS) Whitelist
ALLOWED_ORIGINS=https://dailysave.et,https://www.dailysave.et

# Rate Limiting (Token Bucket)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
